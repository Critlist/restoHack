<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@UTW_TITLE@</title>
    <link rel="stylesheet" href="./xterm.css" />
    <style>
      :root{color-scheme:dark}body{background:#0c0c0c;color:#ccc;font-family:monospace;margin:0;display:flex;flex-direction:column;align-items:center;min-height:100vh}header{text-align:center;padding:12px 16px 4px}header h1{font-size:16px;margin:0 0 4px;font-weight:normal}#terminal{border:1px solid #333;padding:4px;background:#000}#saves{font-size:12px;color:#888;padding:8px 16px 0}#status{font-size:12px;color:#888;padding:8px 16px 16px;text-align:center;max-width:720px}
    </style>
  </head>
  <body>
    <header>
      <h1>hack 1.0.3 in your browser - with restoHack and wasm</h1>
    </header>
    <div id="terminal"></div>
    <div id="saves"></div>
    <div id="status"></div>
    <script src="./xterm.js"></script>
    <script type="module">
      import { openpty } from "./xterm-pty.js";
      import initEmscripten from "./@UTW_MODULE@";
      import { createStorageManager } from "./storage.js";

      const term = new Terminal({ cols: @UTW_COLS@, rows: @UTW_ROWS@ });
      term.open(document.getElementById("terminal"));
      term.focus();
      term.element.addEventListener("click", () => term.focus());

      // PTY layer between xterm.js and the Emscripten game: line
      // discipline, termios ioctls, window size and Ctrl+C handling.
      const { master: leader, slave: follower } = openpty();
      term.loadAddon(leader);

      const storage = createStorageManager({
        filesElement: document.getElementById("saves"),
        statusElement: document.getElementById("status"),
        // Save files are /save/<uid><player>; show just the player name.
        displayName: (file) => {
          const m = file.match(/^\d+(.+)$/);
          return m ? m[1] : null;
        },
      });

      try {
        const game = await initEmscripten(storage.options({
          pty: follower,
          persist: @UTW_PERSIST_JS@,
          persistDir: "@UTW_PERSIST_DIR@",
        }));
        storage.attach(game);
      } catch (e) {
        storage.fail(e);
      }
    </script>
  </body>
</html>
